config BOARD_ENABLE_DCDC
	bool "Enable DCDC mode"
	select SOC_DCDC_NRF52X
	default y
	depends on BOARD_ICEBREAKER

config ZMK_ACTIVITY_TRIGGER_KEYS
	bool "Enable keyboard activity trigger"
	default y
	help
	  Enable activity trigger on key press events

config ZMK_ACTIVITY_TRIGGER_TIME_MS
	int "Activity trigger timeout in milliseconds"
	default 100
	help
	  The time in milliseconds after which an activity trigger is fired
