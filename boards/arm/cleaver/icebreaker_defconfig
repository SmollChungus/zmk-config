CONFIG_SOC_SERIES_STM32F4X=y
CONFIG_SOC_STM32F411XE=y


CONFIG_BOARD_CLEAVER=y

# Enable MPU
CONFIG_ARM_MPU=y

# Enable GPIO
CONFIG_GPIO=y
CONFIG_LED=y
CONFIG_LED_GPIO=y

CONFIG_REBOOT=y


CONFIG_MPU_ALLOW_FLASH_WRITE=y
CONFIG_NVS=y
CONFIG_SETTINGS_NVS=y
CONFIG_FLASH=y
CONFIG_FLASH_PAGE_LAYOUT=y
CONFIG_FLASH_MAP=y




CONFIG_PINCTRL=y

# Windows Battery Reporting Fix
CONFIG_BT_GATT_ENFORCE_SUBSCRIPTION=n

