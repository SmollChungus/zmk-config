CONFIG_SOC_SERIES_STM32F4X=y
CONFIG_SOC_STM32F411XE=y

CONFIG_BOARD_ICEBREAKER=y

# Enable MPU
CONFIG_ARM_MPU=y

# Enable HW stack protection
CONFIG_HW_STACK_PROTECTION=y

# Serial Drivers
CONFIG_SERIAL=y
CONFIG_UART_INTERRUPT_DRIVEN=y
CONFIG_CONSOLE=y
CONFIG_UART_CONSOLE=y

# Enable GPIO
CONFIG_GPIO=y


# Enable USB
CONFIG_USB_DEVICE_STACK=y
CONFIG_USB_DEVICE_HID=y
CONFIG_USB_DEVICE_PRODUCT="Icebreaker Keyboard"

# Enable SPI
CONFIG_SPI=y

# Enable WS2812 LED strip
CONFIG_LED_STRIP=y
# CONFIG_LED_STRIP_RGB_SYNC is not defined in Zephyr 3.5.0

# Enable encoder
CONFIG_EC11=y
CONFIG_EC11_TRIGGER_GLOBAL_THREAD=y

# Enable reset behavior
CONFIG_RESET=y

# Disable Bluetooth since the board doesn't have Bluetooth hardware
CONFIG_ZMK_BLE=n
CONFIG_BT=n

# Enable underglow
CONFIG_ZMK_RGB_UNDERGLOW=y
CONFIG_WS2812_STRIP=y

# Explicitly enable USB
# CONFIG_USB is not defined in Zephyr 3.5.0
CONFIG_USB_DEVICE_DRIVER=y
CONFIG_USB_DC_STM32=y

# Enable clock control
CONFIG_CLOCK_CONTROL=y
# CONFIG_CLOCK_CONTROL_STM32 is not defined in Zephyr 3.5.0

# Enable pinctrl
CONFIG_PINCTRL=y

# Enable I2C
CONFIG_I2C=y

# Enable USB
CONFIG_USB_DEVICE_MANUFACTURER="ZMK Project"
CONFIG_USB_DEVICE_VID=0x1D50
CONFIG_USB_DEVICE_PID=0x615E

# Enable RGB underglow
CONFIG_ZMK_RGB_UNDERGLOW_EFF_START=0
CONFIG_ZMK_RGB_UNDERGLOW_SAT_START=100
CONFIG_ZMK_RGB_UNDERGLOW_BRT_START=10
CONFIG_ZMK_RGB_UNDERGLOW_BRT_STEP=5
CONFIG_ZMK_RGB_UNDERGLOW_BRT_MAX=25
CONFIG_ZMK_RGB_UNDERGLOW_HUE_START=150
CONFIG_ZMK_RGB_UNDERGLOW_HUE_STEP=30
CONFIG_ZMK_RGB_UNDERGLOW_AUTO_OFF_IDLE=y

# LED timeout
CONFIG_ZMK_ACTIVITY_TRIGGER_KEYS=y
CONFIG_ZMK_ACTIVITY_TRIGGER_TIME_MS=100


# Turn on logging, and set ZMK logging to debug output
# CONFIG_LOG=y
# CONFIG_ZMK_USB_LOGGING=y
# CONFIG_ZMK_LOG_LEVEL_DBG=y
# CONFIG_I2C_LOG_LEVEL_DBG=y
# CONFIG_SENSOR_LOG_LEVEL_DBG=y
